# Скопируйте в .env и поменяйте значения. .env в git не коммитится.

# --- Django ---
DEBUG=true
DJANGO_SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000
# адрес сайта: браузер шлёт запросы к API через него (ADR-0010)
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# --- База и Redis (для docker compose) ---
POSTGRES_DB=sofizar
POSTGRES_USER=sofizar
POSTGRES_PASSWORD=sofizar
DATABASE_URL=postgres://sofizar:sofizar@db:5432/sofizar
REDIS_URL=redis://redis:6379/0

# --- Frontend ---
# адрес API для запросов с сервера Next.js (внутри docker-сети)
API_URL=http://backend:8000
# публичный адрес сайта — для canonical, hreflang, sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- SMS (этап 06: подключить провайдера; сейчас код входа пишется в лог backend) ---
SMS_BACKEND=apps.accounts.sms.ConsoleSmsBackend

# --- Интеграции (заполняются на этапах 04–06) ---
ONEC_EXCHANGE_URL=
ONEC_USER=
ONEC_PASSWORD=
BITRIX_WEBHOOK_URL=
UZQR_MERCHANT_ID=
UZQR_SECRET=
